      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "originalText": "Legenda:",
      "autoResize": true
    },
    { "type": "rectangle", "id": "legend_screen", "x": 50, "y": 810, "width": 140, "height": 35,
