---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout>
  <main class="min-h-dvh bg-gradient-to-br from-orange-50 via-white to-purple-50">
    <div class="max-w-3xl mx-auto px-4 py-12">
      <a href="/" class="inline-flex items-center gap-2 text-sm text-brand hover:text-brand-dark transition-colors mb-8">
        ← Voltar
      </a>

      <div class="flex items-center gap-4 mb-8">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand to-purple-600 flex items-center justify-center shadow-lg">
          <span class="text-2xl">📝</span>
        </div>
        <div>
          <h1 class="text-3xl font-display text-gray-800">Blog do Meu Racha</h1>
          <p class="text-sm text-gray-500">Dicas, guias e tudo sobre organização de rachas e esportes</p>
        </div>
      </div>

      {
        posts.length > 0 ? (
          <div class="space-y-6">
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                class="block bg-white rounded-3xl border border-gray-200 p-8 shadow-sm hover:shadow-md hover:border-brand/30 transition-all duration-200"
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="flex-1 min-w-0">
                    <h2 class="text-xl font-display text-gray-800 mb-2 leading-snug">
                      {post.data.title}
                    </h2>
                    <p class="text-gray-600 text-sm leading-relaxed mb-4">
                      {post.data.description}
                    </p>
                    <div class="flex items-center gap-3 text-xs text-gray-400">
                      <time datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toLocaleDateString('pt-BR', {
                          day: 'numeric',
                          month: 'long',
                          year: 'numeric',
                        })}
                      </time>
                      <span>•</span>
                      <span>{post.data.author}</span>
                      {post.data.tags.length > 0 && (
                        <>
                          <span>•</span>
                          <div class="flex gap-1.5">
                            {post.data.tags.map((tag) => (
                              <span class="bg-orange-100 text-orange-700 px-2 py-0.5 rounded-full text-[10px] font-semibold">
                                {tag}
                              </span>
                            ))}
                          </div>
                        </>
                      )}
                    </div>
                  </div>
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300 shrink-0 mt-1">
                    <path d="m9 18 6-6-6-6"/>
                  </svg>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="bg-white rounded-3xl border border-gray-200 p-12 text-center shadow-sm">
            <p class="text-gray-500 text-lg">Nenhum post publicado ainda. Volte em breve!</p>
          </div>
        )
      }
    </div>
  </main>
</Layout>
